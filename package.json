{
  "name": "plastic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A visual editor for real interfaces: HTML and CSS are the design source.",
  "scripts": {
    "dev": "vite",
    "build": "bun run emails:build && bun run typecheck && vite build && bun run site:build",
    "emails:build": "node scripts/build-emails.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.worker.json && bun run reference:typecheck",
    "test": "vitest run",
    "preview": "vite preview",
    "mcp": "bun server/mcp/stdio.ts",
    "cf:dev": "vite build && wrangler dev --local-upstream localhost:8787",
    "db:migrate:local": "wrangler d1 migrations apply plastic --local",
    "db:migrate:remote": "wrangler d1 migrations apply plastic --remote",
    "deploy": "bun run build && wrangler deploy",
    "site:dev": "astro dev --root site",
    "site:build": "astro build --root site",
    "benchmark:figma": "bun scripts/figma/benchmark.mjs",
    "reference:build": "bun scripts/figma/build-plugin.mjs",
    "reference:typecheck": "tsc -p plugins/figma-reference-export/tsconfig.json",
    "reference:unpack": "bun scripts/figma/unpack.mjs",
    "reference:check": "bun run reference:build && bun scripts/figma/check-plugin.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@open-pencil/core": "0.15.1",
    "@open-pencil/scene-graph": "0.15.1",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "async-mutex": "^0.5.0",
    "better-auth": "1.7.7",
    "codemirror": "6.0.2",
    "culori": "^4.0.2",
    "disposable-email-domains-js": "^1.26.0",
    "dompurify": "^3.4.16",
    "html-to-image": "^1.11.13",
    "jsdom": "^30.1.1",
    "loading-dev": "^0.3.5",
    "lucide-react": "^1.49.0",
    "node-diff3": "^3.2.1",
    "paper": "0.12.18",
    "paperjs-offset": "2.2.1",
    "postcss": "^8.5.28",
    "postcss-safe-parser": "^7.1.0",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "prettier": "3.9.9",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.3",
    "svgpath": "^2.6.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@figma/plugin-typings": "^1.140.0",
    "@iconify-json/lucide": "^1.2.139",
    "@iconify-json/simple-icons": "^1.2.98",
    "@types/culori": "^4.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0",
    "fflate": "^0.8.3",
    "pixelmatch": "7.1.0",
    "playwright": "1.58.2",
    "pngjs": "7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "4.147.0"
  },
  "packageManager": "bun@1.4.0"
}
