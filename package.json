{
  "name": "plastic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A visual editor for real interfaces: HTML and CSS are the design source.",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "preview": "vite preview",
    "mcp": "bun server/mcp/stdio.ts",
    "cf:dev": "vite build && wrangler dev --local-upstream localhost:8787",
    "db:migrate:local": "wrangler d1 migrations apply plastic --local",
    "db:migrate:remote": "wrangler d1 migrations apply plastic --remote",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@open-pencil/core": "0.15.1",
    "@open-pencil/scene-graph": "0.15.1",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "async-mutex": "^0.5.0",
    "better-auth": "1.7.7",
    "codemirror": "6.0.2",
    "dompurify": "^3.4.16",
    "html-to-image": "^1.11.13",
    "jsdom": "^30.1.1",
    "loading-dev": "^0.3.5",
    "lucide-react": "^1.49.0",
    "node-diff3": "^3.2.1",
    "paper": "0.12.18",
    "paperjs-offset": "2.2.1",
    "postcss": "^8.5.28",
    "postcss-safe-parser": "^7.1.0",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "prettier": "3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svgpath": "^2.6.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "4.146.0"
  },
  "packageManager": "bun@1.4.0"
}
