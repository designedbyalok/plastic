---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EditorMock from '../components/EditorMock.astro';
import HeroShader from '../components/HeroShader.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import chrome from '../assets/chrome.png';
import { FAQ, FEATURES, SITE } from '../data/site';
import { RELEASES } from '../data/changelog';

const title = 'Plastic • Design real interfaces in HTML and CSS';
const description = SITE.description;

const integrations = [
  { icon: 'simple-icons:figma', label: 'Figma' },
  { icon: 'simple-icons:claude', label: 'Claude' },
  { icon: 'simple-icons:openai', label: 'Codex' },
  { icon: 'simple-icons:cursor', label: 'Cursor' },
  { icon: 'simple-icons:githubcopilot', label: 'GitHub Copilot' },
  { icon: 'simple-icons:git', label: 'Git' },
  { icon: 'simple-icons:html5', label: 'HTML' },
  { icon: 'simple-icons:css', label: 'CSS' },
];

const agents = [
  { icon: 'simple-icons:claude', name: 'Claude' },
  { icon: 'simple-icons:openai', name: 'Codex' },
  { icon: 'simple-icons:cursor', name: 'Cursor' },
  { icon: 'simple-icons:githubcopilot', name: 'Copilot' },
];

const audiences = [
  { title: 'Designers', body: 'Work the way you already do, with frames, layers, a pen tool and an inspector, and know that what you draw is exactly what ships.' },
  { title: 'Design engineers', body: 'Move between canvas and code without a translation layer. A change on one side shows up on the other as you make it.' },
  { title: 'Engineers', body: 'Start from semantic HTML, a real stylesheet and tokens instead of a screenshot to reverse-engineer. Diff it, review it, commit it.' },
  { title: 'Teams with agents', body: 'Give coding agents the actual design source through MCP, and watch their edits land on the canvas while they work.' },
];

const comparison = [
  ['What you save', 'A proprietary file of vector layers', 'Semantic HTML, CSS and tokens'],
  ['Layout', 'Approximations of flexbox', 'Real flex and grid, rendered by the browser'],
  ['Hand-off', 'Specs, redlines and inspect mode', 'The source itself, plus frame links'],
  ['Responsive and states', 'Duplicated frames per breakpoint', 'Media queries and :hover/:focus on one element'],
  ['AI agents', 'Read screenshots and guess the code', 'Read and edit the design directly over MCP'],
  ['Ownership', 'Locked inside an app', 'Plain files in folders, ready for Git'],
];

const steps = [
  { title: 'Draw', body: 'Drop a frame and add text, inputs and buttons, or bring in a Figma file. Wrap a selection in a stack and Plastic infers the direction and gap.' },
  { title: 'Refine', body: 'Tune layout, type, fills and gradients in the inspector. Add hover and focus states, breakpoints, components and variants.' },
  { title: 'Ship', body: 'Open the code panel and it is already HTML and CSS. Hand engineers a frame link, let an agent build on it, or commit the folder.' },
];

const latest = RELEASES.slice(0, 3);
const date = new Intl.DateTimeFormat('en', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const schema = [
  {
    '@type': 'SoftwareApplication',
    name: 'Plastic',
    url: SITE.url,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Web browser; macOS and Windows (coming soon)',
    description,
    image: SITE.ogImage,
    publisher: { '@id': `${SITE.url}/#organization` },
    featureList: FEATURES.map((f) => f.title),
  },
  {
    '@type': 'FAQPage',
    mainEntity: FAQ.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
  },
];
---

<Base title={title} description={description} path="/" schema={schema}>
  <!-- Hero -->
  <section class="hero">
    <HeroShader />
    <div class="wrap hero-inner">
      <p class="pill">Invite-only preview • Inviting in waves</p>
      <h1 class="display">Design with<br />the real thing.</h1>
      <p class="lede">
        Plastic is a visual design tool where HTML and CSS are the design. You draw, lay out and style on a canvas, and the file you save is the interface itself, ready to ship.
      </p>
      <div class="hero-form">
        <WaitlistForm id="hero" source="home" page="/" cta="Request an invite" />
        <p class="hero-note">Already invited? <a href={SITE.signIn}>Sign in</a></p>
      </div>
    </div>
    <div class="wrap hero-visual">
      <EditorMock />
    </div>
  </section>

  <!-- Integrations -->
  <section class="logos hairline" aria-label="Works with">
    <div class="wrap logos-inner">
      <p class="logos-title">Works with the tools your team already uses</p>
      <ul class="logos-list">
        {integrations.map((item) => <li><Icon name={item.icon} aria-hidden="true" /><span>{item.label}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- The idea -->
  <section class="idea">
    <div class="wrap split">
      <div>
        <h2 class="title">Stop drawing pictures of interfaces.</h2>
        <p class="lede">
          Most design tools save a picture of an interface. Someone then rebuilds it in code, and every spacing value, state and breakpoint gets interpreted again on the way. Plastic skips that step. The canvas renders real HTML and CSS in a browser engine, so what you design is what the browser draws.
        </p>
        <ul class="checks">
          <li><Icon name="lucide:check" aria-hidden="true" />Semantic elements: forms, inputs, buttons, tables and headings</li>
          <li><Icon name="lucide:check" aria-hidden="true" />Your stylesheet and tokens, with the cascade intact</li>
          <li><Icon name="lucide:check" aria-hidden="true" />One folder per file, ready for any editor or for Git</li>
        </ul>
      </div>
      <figure class="code-card card" aria-label="What Plastic saves">
        <div class="code-card-head">
          <span><Icon name="lucide:file-code-2" aria-hidden="true" /> workspace/sign-in/index.html</span>
          <span class="saved">Saved</span>
        </div>
<pre><code><span class="p">&lt;</span><span class="t">form</span> <span class="a">class</span><span class="p">=</span><span class="s">"login-form"</span><span class="p">&gt;</span>
  <span class="p">&lt;</span><span class="t">h2</span> <span class="a">class</span><span class="p">=</span><span class="s">"heading"</span><span class="p">&gt;</span>Sign in<span class="p">&lt;/</span><span class="t">h2</span><span class="p">&gt;</span>
  <span class="p">&lt;</span><span class="t">label</span> <span class="a">class</span><span class="p">=</span><span class="s">"field"</span><span class="p">&gt;</span>Email
    <span class="p">&lt;</span><span class="t">input</span> <span class="a">class</span><span class="p">=</span><span class="s">"input"</span> <span class="a">type</span><span class="p">=</span><span class="s">"email"</span>
           <span class="a">placeholder</span><span class="p">=</span><span class="s">"you@example.com"</span> <span class="a">required</span><span class="p">&gt;</span>
  <span class="p">&lt;/</span><span class="t">label</span><span class="p">&gt;</span>
  <span class="p">&lt;</span><span class="t">button</span> <span class="a">class</span><span class="p">=</span><span class="s">"button"</span> <span class="a">type</span><span class="p">=</span><span class="s">"submit"</span><span class="p">&gt;</span>Continue<span class="p">&lt;/</span><span class="t">button</span><span class="p">&gt;</span>
<span class="p">&lt;/</span><span class="t">form</span><span class="p">&gt;</span>

<span class="c">/* styles.css */</span>
<span class="k">.login-form</span> <span class="p">&#123;</span> <span class="pr">display</span><span class="p">:</span> <span class="n">flex</span><span class="p">;</span> <span class="pr">gap</span><span class="p">:</span> <span class="n">var</span>(<span class="v">--space-4</span>)<span class="p">;</span> <span class="p">&#125;</span>
<span class="k">.button:hover</span> <span class="p">&#123;</span> <span class="pr">background</span><span class="p">:</span> <span class="n">var</span>(<span class="v">--accent-strong</span>)<span class="p">;</span> <span class="p">&#125;</span></code></pre>
        <figcaption>That’s the file. It isn’t an export; it’s the design.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Comparison -->
  <section class="compare hairline">
    <div class="wrap">
      <div class="section-head">
        <h2 class="title">Same craft, without the translation.</h2>
        <p class="lede">Everything you expect from a design tool, built on the platform your work ends up on.</p>
      </div>
      <div class="compare-table" role="table" aria-label="Plastic compared with picture-based design tools">
        <div class="compare-row compare-headrow" role="row">
          <span role="columnheader"></span>
          <span role="columnheader">Picture-based tools</span>
          <span role="columnheader">Plastic</span>
        </div>
        {
          comparison.map(([label, before, after]) => (
            <div class="compare-row" role="row">
              <span role="rowheader">{label}</span>
              <span role="cell" class="before">{before}</span>
              <span role="cell" class="after">{after}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="features hairline">
    <div class="wrap">
      <div class="section-head">
        <h2 class="title">A complete canvas, down to the last anchor point.</h2>
        <p class="lede">Layout, vectors, type, color, components and states. Every tool writes standard HTML, CSS and SVG you can read.</p>
      </div>
      <ul class="feature-list">
        {
          FEATURES.map((feature) => (
            <li>
              <Icon name={feature.icon} aria-hidden="true" />
              <div>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Agents -->
  <section id="agents" class="agents hairline">
    <div class="wrap split">
      <div>
        <h2 class="title">Your coding agent, on the canvas.</h2>
        <p class="lede">
          Plastic speaks the Model Context Protocol. Connect Claude, Codex, Cursor, GitHub Copilot or any MCP-capable agent. It can read a selected frame with its full styling context, change designs and tokens, and build from the real source.
        </p>
        <ul class="checks">
          <li><Icon name="lucide:check" aria-hidden="true" />Edits appear live, and every one can be undone</li>
          <li><Icon name="lucide:check" aria-hidden="true" />See which layers an agent is reading or editing</li>
          <li><Icon name="lucide:check" aria-hidden="true" />Frame links hand an exact frame to any agent or engineer</li>
        </ul>
        <ul class="agent-logos">
          {agents.map((agent) => <li><Icon name={agent.icon} aria-hidden="true" />{agent.name}</li>)}
        </ul>
      </div>
      <div class="agent-card card" aria-hidden="true">
        <div class="agent-head">
          <span class="agent-badge"><Icon name="simple-icons:claude" /></span>
          <div>
            <strong>Claude</strong>
            <span>Connected over MCP</span>
          </div>
        </div>
        <ol class="agent-log">
          <li><Icon name="lucide:scan-eye" /><span>Read frame <b>Sign in</b> with styles and tokens</span></li>
          <li><Icon name="lucide:palette" /><span>Set <b>--accent</b> to <code>#4d8ae4</code> in tokens.css</span></li>
          <li><Icon name="lucide:mouse-pointer-click" /><span>Added a <b>:focus-visible</b> ring to <b>.input</b></span></li>
          <li class="is-active"><Icon name="lucide:pencil" /><span>Editing the <b>Hint</b> text</span></li>
        </ol>
        <div class="agent-prompt">“Make the sign-in form accessible and match our tokens.”</div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="how hairline">
    <div class="wrap">
      <div class="section-head">
        <h2 class="title">Draw, refine, ship.</h2>
        <p class="lede">One source of truth from the first frame to the shipped page, so there is nothing to export at the end.</p>
      </div>
      <ol class="steps">
        {
          steps.map((step, i) => (
            <li>
              <span class="step-n">Step {i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Audiences -->
  <section class="audiences hairline">
    <div class="wrap">
      <div class="section-head">
        <h2 class="title">One file for everyone who touches the interface.</h2>
      </div>
      <ul class="audience-grid">
        {
          audiences.map((a) => (
            <li>
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Brand -->
  <section class="brand-band hairline" aria-labelledby="brand-title">
    <div class="wrap">
      <figure class="brand-card">
        <Image src={chrome} alt="The Plastic emblem in liquid chrome, floating above flowing silver ribbons." widths={[640, 1100, 1672]} sizes="(max-width: 1240px) 100vw, 1200px" />
        <figcaption>
          <h2 id="brand-title" class="title">Indestructible Design.</h2>
          <p>Nothing breaks between design and production, because there is nothing to convert.</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Changelog teaser -->
  <section class="latest hairline">
    <div class="wrap">
      <div class="latest-head">
        <h2 class="title">Recent updates</h2>
        <a class="text-link" href="/changelog">Full changelog <Icon name="lucide:arrow-right" aria-hidden="true" /></a>
      </div>
      <ul class="latest-list">
        {
          latest.map((release) => (
            <li>
              <a href={`/changelog#${release.id}`}>
                <time datetime={release.date}>{date.format(new Date(release.date))}</time>
                <h3>{release.title}</h3>
                <p>{release.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Invite-only -->
  <section id="invite-only" class="invite hairline">
    <div class="wrap invite-grid">
      <div>
        <h2 class="title">Why invite-only</h2>
        <p class="lede">We would rather give fewer people a fast, reliable workspace than everyone a slow one.</p>
      </div>
      <dl class="invite-points">
        <div>
          <dt>Room for everyone inside</dt>
          <dd>Every workspace comes with cloud storage, live sync and email. Inviting people in waves keeps it quick and reliable for the people already using it.</dd>
        </div>
        <div>
          <dt>Shaped by early users</dt>
          <dd>Tell us what you want to make. It shapes who we invite next and what we build next, and the changelog shows the results.</dd>
        </div>
        <div>
          <dt>One email when it’s your turn</dt>
          <dd>Your invite arrives at the address you gave us, with a sign-up link. No newsletters, no drip campaigns.</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="faq hairline">
    <div class="wrap invite-grid">
      <div>
        <h2 class="title">Questions</h2>
        <p class="lede">Something else? Ask in your waitlist note. We read every one.</p>
      </div>
      <div class="faq-list">
        {
          FAQ.map((item) => (
            <details class="faq-item">
              <summary>
                {item.q}
                <Icon name="lucide:plus" aria-hidden="true" />
              </summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Waitlist -->
  <section id="waitlist" class="join hairline">
    <div class="wrap join-inner">
      <div>
        <h2 class="display join-title">Make something that lasts.</h2>
        <p class="lede">Join the waitlist for the invite-only preview. Tell us a little about yourself and what you’d make first; it helps us invite the right people sooner.</p>
      </div>
      <div class="join-card card">
        <WaitlistForm id="waitlist-form" source="home" page="/" variant="full" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding: clamp(64px, 10vw, 128px) 0 0;
    overflow: hidden;
  }

  .hero-inner,
  .hero-visual {
    position: relative;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero .lede {
    max-width: 640px;
    margin-inline: auto;
  }

  .hero-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: 100%;
    max-width: 520px;
    margin-top: 36px;
  }

  .hero-form :global(.inline-row) {
    margin-inline: auto;
  }

  .hero-note {
    margin: 0;
    color: var(--text-3);
    font-size: 14px;
  }

  .hero-note a,
  .text-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .hero-note a:hover,
  .text-link:hover {
    text-decoration-color: currentColor;
  }

  .hero-visual {
    margin-top: clamp(56px, 8vw, 96px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  /* Logos */
  .logos {
    padding: 36px 0;
  }

  .logos-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
  }

  .logos-title {
    margin: 0;
    color: var(--text-3);
    font-size: 14px;
  }

  .logos-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logos-list li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-2);
    font-size: 14px;
  }

  .logos-list svg {
    width: 16px;
    height: 16px;
  }

  /* Two-column sections */
  .split {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  @media (max-width: 960px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  .checks {
    display: grid;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .checks li {
    display: flex;
    gap: 12px;
    color: var(--text-2);
  }

  .checks svg {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 5px;
    color: var(--text-3);
  }

  /* Code card */
  .code-card {
    overflow: hidden;
    margin: 0;
  }

  .code-card-head {
    display: flex;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    color: var(--text-2);
    font-size: 13px;
  }

  .code-card-head span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .code-card-head svg {
    width: 15px;
    height: 15px;
  }

  .saved {
    color: var(--text-3);
  }

  .code-card pre {
    margin: 0;
    padding: 20px 18px;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.75;
  }

  .t {
    color: var(--code-tag);
  }
  .a {
    color: var(--code-attribute);
  }
  .s {
    color: var(--code-string);
  }
  .p {
    color: var(--code-punctuation);
  }
  .c {
    color: var(--text-3);
    font-style: italic;
  }
  .k {
    color: var(--code-class);
  }
  .pr {
    color: var(--code-property);
  }
  .n {
    color: var(--code-number);
  }
  .v {
    color: var(--code-attribute);
  }

  .code-card figcaption {
    padding: 14px 18px;
    border-top: 1px solid var(--line);
    color: var(--text-2);
    font-size: 14px;
  }

  /* Comparison */
  .compare-table {
    border-top: 1px solid var(--line-strong);
  }

  .compare-row {
    display: grid;
    grid-template-columns: 0.8fr 1.1fr 1.1fr;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }

  .compare-headrow {
    color: var(--text-3);
    font-size: 13px;
  }

  .compare-row [role='rowheader'] {
    color: var(--text-2);
  }

  .before {
    color: var(--text-3);
  }

  .after {
    color: var(--text);
  }

  @media (max-width: 720px) {
    .compare-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .compare-headrow {
      display: none;
    }
    .before::before {
      content: 'Others: ';
    }
    .after::before {
      content: 'Plastic: ';
      color: var(--text-3);
    }
  }

  /* Features */
  .feature-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(32px, 6vw, 80px);
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }

  .feature-list li {
    display: flex;
    gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .feature-list svg {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 3px;
    color: var(--text-2);
  }

  .feature-list h3,
  .steps h3,
  .audience-grid h3 {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .feature-list p,
  .steps p,
  .audience-grid p {
    margin: 0;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .feature-list {
      grid-template-columns: 1fr;
    }
  }

  /* Agents */
  .agent-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .agent-logos li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-2);
    font-size: 14px;
  }

  .agent-logos svg {
    width: 15px;
    height: 15px;
  }

  .agent-card {
    padding: 8px;
  }

  .agent-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
  }

  .agent-head div {
    display: grid;
  }

  .agent-head span {
    color: var(--text-3);
    font-size: 13px;
  }

  .agent-badge {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: #d97757;
    color: #fff;
  }

  .agent-badge svg {
    width: 17px;
    height: 17px;
  }

  .agent-log {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .agent-log li {
    display: grid;
    grid-template-columns: 16px 1fr;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
