{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plastic",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Served only on the custom domain (the auth URL and cookies are tied to it).
  "routes": [{ "pattern": "useplastic.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The editor is a single-page app: /file/<id> and other routes serve index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plastic",
      // Created with `bunx wrangler d1 create plastic` (Plastic account). wrangler dev uses a local copy.
      "database_id": "5a937fda-2a09-48ba-a7a1-fc8d0c92c5dd",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      // Project files and images, under users/<user id>/projects/<project id>/.
      "binding": "FILES",
      "bucket_name": "plastic-files"
    }
  ],
  "vars": {
    // Public URL of the app. `wrangler dev` overrides it from .dev.vars.
    "BETTER_AUTH_URL": "https://useplastic.app"
  },
  "observability": { "enabled": true }
}
