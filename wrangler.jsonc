{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plastic",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The editor is a single-page app: /file/<id> and other routes serve index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plastic",
      // Created with `bunx wrangler d1 create plastic` (Plastic account). wrangler dev uses a local copy.
      "database_id": "5a937fda-2a09-48ba-a7a1-fc8d0c92c5dd",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Your public URL once deployed (e.g. https://plastic.<you>.workers.dev or a custom domain).
    "BETTER_AUTH_URL": "http://localhost:8787"
  },
  "observability": { "enabled": true }
}
